<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <AssemblyName>SteamKitSDK</AssemblyName>
        <RootNamespace>SteamKitSDK</RootNamespace>
        <PackageId>SteamKitSDK</PackageId>

        <VersionSuffix>$(VersionSuffix)</VersionSuffix>
        <Version>0.9.3</Version>
        <Version Condition=" '$(VersionSuffix)' != '' ">$(Version)-$(VersionSuffix)</Version>

        <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
        <Authors>pat2381</Authors>
        <Copyright>Copyright (c) 2026 pat2381</Copyright>
        <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
        <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>logo_squared_128.png</PackageIcon>
        <RepositoryUrl>https://github.com/pat2381/SteamKitSDK</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageProjectUrl>https://github.com/pat2381/SteamKitSDK</PackageProjectUrl>
        <PackageTags>steam;steamkit;steamkit2;workshop;content-download;depot;steam-guard;dotnet</PackageTags>
        <Description>Modern .NET SDK for authorized Steam application-content and Workshop downloads, Steam Guard authentication, branch queries, progress reporting, and local-file verification, powered by SteamKit2.</Description>
        <PackageReleaseNotes>0.9.3: Corrected the package copyright metadata to identify the current package maintainer.</PackageReleaseNotes>
        <Company>pat2381</Company>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
        <PackageReference Include="Nito.AsyncEx" Version="5.1.2" />
        <PackageReference Include="SteamKit2" Version="3.4.0" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\LICENSE.md">
            <Pack>True</Pack>
            <PackagePath></PackagePath>
        </None>
        <None Include="..\README.md">
            <Pack>True</Pack>
            <PackagePath></PackagePath>
        </None>
        <None Include="logo_squared_128.png">
            <Pack>True</Pack>
            <PackagePath></PackagePath>
        </None>
    </ItemGroup>

    <PropertyGroup>
        <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);CopyProjectReferencesToPackage</TargetsForTfmSpecificBuildOutput>
    </PropertyGroup>

    <Target Name="CopyProjectReferencesToPackage" DependsOnTargets="ResolveReferences">
        <ItemGroup>
            <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths-&gt;WithMetadataValue('ReferenceSourceTarget', 'ProjectReference'))" />
        </ItemGroup>
    </Target>
</Project>
